{
  "name": "dada-ai-toolkit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.ts",
    "slides": "slidev slides/slides.md --port 3030 --bind 127.0.0.1",
    "slides:build": "node scripts/build-slides.mjs",
    "slides:export": "slidev export slides/slides.md --output exports/the-ai-toolkit.pdf",
    "slides:mcp": "slidev mcp slides/slides.md",
    "build:all": "npm run slides:build && npm run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@slidev/cli": "53.0.0",
    "@tailwindcss/vite": "4.3.3",
    "nuxt": "4.6.3",
    "slidev-theme-unicorn": "1.1.2",
    "tailwindcss": "4.3.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-chromium": "^1.56.0",
    "typescript": "^5.9.0",
    "unocss": "^66.6.0",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "@slidev/cli": "53.0.0",
    "@slidev/client": "53.0.0",
    "floating-vue": "5.2.2"
  },
  "engines": { "node": ">=22.12" }
}
